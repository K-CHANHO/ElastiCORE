{
  "$comment": "Generated by agent-export from usecase: blocks. One MCP tool per use case. name/description/schemas come from the declaration; x-elasticore carries what no agent standard has a field for.",
  "tools": [
    {
      "name": "shop.placeOrder",
      "description": "A customer turns a pending order into one the shop has accepted",
      "inputSchema": {
        "type": "object",
        "required": ["orderId", "country", "weight"],
        "properties": {
          "orderId": {"type": "string", "maxLength": 36},
          "country": {"type": "string", "maxLength": 50},
          "weight":  {"type": "number"}
        }
      },
      "outputSchema": {"$ref": "#/schemas/OrderDTO"},
      "x-elasticore": {
        "on": "Order",
        "effects": {"reads": ["Customer", "Product"], "writes": ["Order"], "emits": ["Placed"]},
        "requires": {
          "NOT_PENDING":       "order.status == PENDING",
          "CUSTOMER_INACTIVE": "order.customer.active",
          "EMPTY_ORDER":       "order.items.size() > 0",
          "BAD_QUANTITY":      "order.items.all(i, i.quantity > 0)"
        },
        "ensures": ["result.status == CONFIRMED", "result.totalAmount >= 0"],
        "declaration": "blueprint/shop/model/logic.yml#usecase.PlaceOrder",
        "version": "3.1.<build>"
      }
    },
    {
      "name": "shop.cancelOrder",
      "description": "The customer or the shop withdraws an order before it ships",
      "inputSchema": {
        "type": "object",
        "required": ["orderId"],
        "properties": {
          "orderId": {"type": "string", "maxLength": 36},
          "reason":  {"type": "string", "maxLength": 200}
        }
      },
      "outputSchema": {"$ref": "#/schemas/OrderDTO"},
      "x-elasticore": {
        "on": "Order",
        "effects": {"writes": ["Order"], "emits": ["Cancelled"]},
        "requires": {"NOT_CANCELLABLE": "order.status in [PENDING, CONFIRMED, PROCESSING]"},
        "ensures": ["result.status == CANCELLED"],
        "declaration": "blueprint/shop/model/logic.yml#usecase.CancelOrder",
        "version": "3.1.<build>"
      }
    }
  ]
}
