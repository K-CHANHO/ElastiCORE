# Ignore Gradle project-specific cache directory
HELP.md
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Node.js dependencies and files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
package.json

# Screenshots and temporary files  
*.png
screenshot.js
*.jpg
*.jpeg

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# Backup files
*.bak
*.tmp

# The repository root is not an ElastiCORE project. Generation used to land here
# when the model extractor fell back to the JVM working directory, which under
# Gradle is the root project rather than the module being built. That fallback is
# gone; this keeps an older jar from putting it back.
/src/

# IDE and local tool settings - per developer, never shared
.idea/
*.iml
.vscode/

# Local databases and traces from running samples
*.mv.db
*.trace.db
