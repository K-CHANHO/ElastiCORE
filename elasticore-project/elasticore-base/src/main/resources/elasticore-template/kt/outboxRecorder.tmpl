/**
 * Writes every domain event of the domain to the outbox, in the transaction
 * that raised it: the message exists if and only if the change does.
 *
 * Generated by ElastiCORE. Do not edit outside the ElastiCORE guidelines.
 */
@Component
class ${className}(
    private val outbox: ${repositoryName},
    mapper: ObjectProvider<ObjectMapper>
) {

    /** The application's ObjectMapper where there is one; a plain one with the classpath's modules otherwise. */
    private val json: ObjectMapper = mapper.getIfAvailable { ObjectMapper().findAndRegisterModules() }

    ${handlerList}
    private fun record(aggregateType: String, aggregateId: Any?, event: Any, occurredOn: Instant?) {
        val message = ${messageName}()
        message.aggregateType = aggregateType
        message.aggregateId = aggregateId?.toString()
        message.eventType = event.javaClass.name
        message.payload = try {
            json.writeValueAsString(event)
        } catch (e: JsonProcessingException) {
            // Refusing the commit is the point: an event that cannot be sent
            // must not leave behind a change the rest of the system never hears of.
            throw IllegalStateException("Domain event cannot be written to the outbox: $event", e)
        }
        message.occurredOn = occurredOn
        message.recordedAt = Instant.now()
        outbox.save(message)
    }
}
